        "jsCode": "const items = $input.all();\nconst now = new Date();\nconst lembretes = [];\nfor (const item of items) {\n  const appt = item.json;\n  if (!appt?.data_inicio) continue;\n  const eventStart = new Date(appt.data_inicio);\n  const hoursUntil = (eventStart - now) / (1000*60*60);\n  if (hoursUntil >= 20 && hoursUntil <= 28) {\n    lembretes.push({json:{apptId:appt.id,number:appt.paciente_telefone,patientName:appt.paciente_nome,doctorName:appt.profissional,eventDate:eventStart.toLocaleDateString('pt-BR',{weekday:'long',day:'numeric',month:'long'}),eventTime:eventStart.toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'})}});\n  }\n}\nif (!lembretes.length) return [{json:{status:'no_reminders'}}];\nreturn lembretes;"
      },
