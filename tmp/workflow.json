        "jsonBody": "={\n  \"model\": \"gpt-4o\",\n  \"max_tokens\": 1500,\n  \"temperature\": 0.1,\n  \"response_format\": { \"type\": \"json_object\" },\n  \"messages\": [\n    { \"role\": \"system\", \"content\": \"Especialista em contabilidade brasileira. Analise a imagem e retorne APENAS JSON. Categorias: Débitos, Impostos, Repasses, Fixas, Variáveis. Se não conseguir ler retorne {\\\"gastos\\\":[], \\\"confianca\\\":\\\"baixa\\\"}\" },\n    { \"role\": \"user\", \"content\": [ { \"type\": \"text\", \"text\": \"Extraia dados financeiros. JSON:\\n{\\\"documento_tipo\\\":\\\"...\\\",\\\"data_documento\\\":\\\"YYYY-MM-DD\\\",\\\"descricao_geral\\\":\\\"...\\\",\\\"gastos\\\":[{\\\"descricao\\\":\\\"...\\\",\\\"valor\\\":0.00,\\\"data\\\":\\\"YYYY-MM-DD\\\",\\\"categoria\\\":\\\"Débitos|Impostos|Repasses|Fixas|Variáveis\\\",\\\"metodo_pagamento\\\":\\\"pix|cartao_credito|cartao_debito|dinheiro|boleto|transferencia|nao_identificado\\\",\\\"fornecedor\\\":\\\"...\\\",\\\"numero_documento\\\":\\\"...\\\"}],\\\"total\\\":0.00,\\\"confianca\\\":\\\"alta|media|baixa\\\"}\" }, { \"type\": \"image_url\", \"image_url\": { \"url\": \"{{ $json.fileURL || $json.url || $json.link || '' }}\", \"detail\": \"high\" } } ] } ] }",
