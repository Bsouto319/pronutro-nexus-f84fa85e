    {
      "parameters": {
        "jsCode": "try {\n  const raw = $json.choices?.[0]?.message?.content || '{}';\n  let ocrData;\n  try { ocrData = JSON.parse(raw); } catch(e) { const m = raw.match(/\\{[\\s\\S]*\\}/); ocrData = m ? JSON.parse(m[0]) : {}; }\n  const norm = $('🔄 Normalizar Entrada').first().json;\n  const hoje = new Date().toISOString().split('T')[0];\n  const gastos = (ocrData.gastos || []).map(g => ({\n    organization_id: norm.organizationId || 'default_tenant',\n    descricao: g.descricao || 'Item',\n    valor: parseFloat(String(g.valor||0).replace(',','.')) || 0,\n    data_gasto: (g.data||hoje).match(/\\d{4}-\\d{2}-\\d{2}/)?.[0] || hoje,\n    categoria: g.categoria || 'Variáveis',\n    metodo_pagamento: g.metodo_pagamento || 'nao_identificado',\n    fornecedor: g.fornecedor || '',\n    numero_documento: g.numero_documento || '',\n    documento_tipo: ocrData.documento_tipo || 'outro',\n    confianca_ocr: ocrData.confianca || 'baixa',\n    source_type: 'whatsapp_ocr',\n    created_at: new Date().toISOString()\n  }));\n  return [{ json: { sucesso: gastos.length > 0, gastos, totalGastos: gastos.length, totalValor: gastos.reduce((s,g)=>s+g.valor,0), organizationId: norm.organizationId||'default_tenant', senderNumber: norm.number, confianca: ocrData.confianca||'baixa' } }];\n} catch(err) {\n  const norm = $('🔄 Normalizar Entrada').first().json;\n  return [{ json: { sucesso: false, gastos: [], totalGastos: 0, organizationId: norm.organizationId, senderNumber: norm.number, erro: err.message } }];\n}"
      },
