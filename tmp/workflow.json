      "parameters": {
        "jsCode": "try {\n  const data = $json.body || $json;\n  const msg = data.message || {};\n\n  if (msg.fromMe === true) {\n    return [{ json: { skip: true, reason: 'bot_message' } }];\n  }\n\n  let senderRaw = msg.sender_pn || msg.chatid || \"\";\n  let number = senderRaw.split('@')[0].replace(/\\D/g, '');\n\n  if (number.startsWith('167') || number.length > 13) {\n    return [{ json: { skip: true, reason: 'invalid_lid', id: number } }];\n  }\n\n  if (number.length >= 10 && number.length <= 11) {\n    number = '55' + number;\n  }\n\n  const rawType = (msg.type || msg.messageType || 'text').toLowerCase();\n  let mType = 'text';\n  if (rawType.includes('audio') || rawType === 'ptt') mType = 'audio';\n  if (rawType.includes('image')) mType = 'image';\n\n  return [{ json: {\n    skip: false,\n    number: number,\n    chatId: number + '@s.whatsapp.net',\n    senderName: (msg.senderName || data.chat?.name || 'CLIENTE').toUpperCase(),\n    messageType: mType,\n    messageContent: (msg.text || msg.content || '').trim(),\n    messageId: msg.messageid || msg.id\n  }}];\n\n} catch(err) {\n  return [{ json: { skip: true, reason: 'error', error: err.message } }];\n}"
      },
